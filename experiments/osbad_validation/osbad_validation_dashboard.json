      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb-dt"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT to_timestamp(cycle_index * 86400) AS \"time\", z_score AS \"z-score (ΔV_max,cyc)\" FROM osbad_validation WHERE z_score IS NOT NULL ORDER BY cycle_index",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
