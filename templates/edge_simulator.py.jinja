import json
import os
import sys
import time
from datetime import datetime, timezone

import numpy as np
import paho.mqtt.client as mqtt

MQTT_HOST = os.environ.get("MQTT_HOST", "localhost")
MQTT_PORT = int(os.environ.get("MQTT_PORT", "1883"))
MQTT_TOPIC_PREFIX = "{{ mqtt_topic_prefix }}"
MQTT_EVENTS_TOPIC = "{{ mqtt_events_topic }}"
MQTT_COMMANDS_TOPIC = "{{ mqtt_commands_topic }}"
SAMPLING_RATE_MS = int(os.environ.get("SAMPLING_RATE_MS", "1000"))
FREQUENCY_NOMINAL = 50.0
QUALITY_THRESHOLD_LOW_F = 49.95
SUPERVISORY_COMMAND_TTL_S = 10.0
CONTROL_MODE = os.environ.get("CONTROL_MODE", "active")  # "active" | "observe"

# Πόσο "αδρανές" είναι το καιρικό σήμα ανά βήμα: 0.0 = παγωμένο, 1.0 = καθόλου
# συνέχεια (ίδιο με πριν, τελείως τυχαίο κάθε βήμα). Χαμηλή τιμή -> ομαλές,
# ρεαλιστικές μεταβάσεις αντί για απότομα "τηλεμεταφερμένα" άλματα.
WEATHER_SMOOTHING_ALPHA = float(os.environ.get("WEATHER_SMOOTHING_ALPHA", "0.12"))

# Συντελεστής απόσβεσης φορτίου ως προς τη συχνότητα (load-frequency damping):
# όσο πιο μακριά η συχνότητα από τα 50Hz, τόσο πιο πολύ "αντιστέκεται" το
# φορτίο (π.χ. κινητήρες), φρενάροντας φυσικά την απόκλιση αντί να τη αφήνει
# να συσσωρεύεται απεριόριστα μέχρι το τεχνητό όριο ασφαλείας [35,65]Hz.
FREQUENCY_DAMPING_D = float(os.environ.get("FREQUENCY_DAMPING_D", "0.06"))

# Τελευταία supervisory εντολή από το Analytics Consumer (μέσω Kafka -> MQTT
# sink), με timestamp λήξης· βλ. apply_supervisory_override() παρακάτω.
_latest_supervisory_command = {"command": None, "factor": None, "received_at": 0.0}

# ---------------------------------------------------------------------------
# Κατανομές τηλεμετρίας ανά στοιχείο (instance > class > global > default),
# επιλυμένες ήδη στο Python side του generator (DistributionResolver).
# ---------------------------------------------------------------------------

NODE_DISTRIBUTIONS = {{ node_distributions | pyrepr }}

DIST_SAMPLERS = {
    'WEIBULL':   lambda p: float(p['scale'] * np.random.weibull(p['shape'])),
    'NORMAL':    lambda p: float(np.random.normal(p['mu'], p['sigma'])),
    'BETA':      lambda p: float(np.random.beta(p['alpha'], p['beta'])),
    'LOGNORMAL': lambda p: float(np.random.lognormal(p['mu'], p['sigma'])),
    'GAMMA':     lambda p: float(np.random.gamma(p['shape'], p['scale'])),
    'POISSON':   lambda p: float(np.random.poisson(p['lam'])),
}


def sample(node_id, variable, default=0.0):
    cfg = NODE_DISTRIBUTIONS.get(node_id, {}).get(variable)
    if cfg is None:
        return default
    return DIST_SAMPLERS[cfg['type']](cfg['params'])


class PowerGridTopology:
    def __init__(self):
        self.grid_name = ""
        self.region = ""
        self.nodes = {}
        self.lines = []
        self.frequency = FREQUENCY_NOMINAL
        self.inertia_H = 4.0
        self.p_rated = 1.0

    def add_node(self, node_id, node_type, max_cap=0.0, demand=0.0, pf=0.9, voltage=20.0, has_smart=False):
        if node_id in self.nodes:
            return
        self.nodes[node_id] = {
            'id': node_id,
            'type': node_type,
            'max_capacity_mw': max_cap,
            'demand_mw': demand,
            'power_factor': pf,
            'voltage_level': voltage,
            'has_smart_appliances': has_smart,
            'sim_active_power': 0.0,
            'sim_reactive_power': 0.0,
            'sim_measured_voltage': voltage,
            'sim_measured_current': 0.0,
            'congestion_level': 0.0,
            'state_of_charge': 0.5 if node_type == 'BatteryStorage' else 0.0,
            '_wind_state': None,   # AR(1) smoothed wind speed, βλ. process_telemetry_physics
            '_cloud_state': None,  # AR(1) smoothed cloud cover
        }

    def add_line(self, line_id, length, max_cap, source, target):
        self.lines.append({
            'id': line_id,
            'length_km': length,
            'max_capacity_mw': max_cap,
            'source': source,
            'target': target,
            'status': 'ACTIVE',
            'R': 0.12 * length,
            'X': 0.40 * length,
            'p_flow': 0.0,
            'q_flow': 0.0,
            's_flow': 0.0,
            'p_loss': 0.0,
        })


def build_topology():
    grid = PowerGridTopology()
    grid.grid_name = "{{ grid_name }}"
    grid.region = "{{ grid_region }}"

    {% for n in node_summaries %}
    grid.add_node(
        node_id="{{ n.id }}",
        node_type="{{ n.type }}",
        max_cap={{ n.max_capacity_mw }},
        demand={{ n.demand_mw }},
        pf={{ n.power_factor }},
        voltage={{ n.voltage_level }},
        has_smart={{ n.has_smart_appliances }},
    )
    {% endfor %}
    {% for l in all_lines %}
    grid.add_line(
        line_id="{{ l.id }}",
        length={{ l.length_km }},
        max_cap={{ l.max_capacity_mw }},
        source="{{ l.source }}",
        target="{{ l.target }}",
    )
    {% endfor %}

    total_caps = sum(node['max_capacity_mw'] for node in grid.nodes.values() if node['max_capacity_mw'] > 0)
    total_demands = sum(node['demand_mw'] for node in grid.nodes.values() if node['demand_mw'] > 0)
    grid.p_rated = max(5.0, max(total_caps, total_demands) * 1.2)
    grid.inertia_H = 5.0 if grid.p_rated > 50.0 else 3.5
    return grid


def compute_line_flows(grid):
    total_losses = 0.0
    for node_id, node in grid.nodes.items():
        v_nom = node['voltage_level']
        if node['type'] in ['ThermalPlant', 'SolarPark', 'WindFarm']:
            p_net = node['sim_active_power']
        elif node['type'] in ['Residential', 'Industrial', 'BatteryStorage']:
            p_net = -node['sim_active_power']
        else:
            p_net = 0.0

        alpha = 0.0008
        sensor_noise = sample(node_id, 'voltage_noise', default=np.random.normal(0, 0.003))
        v_dynamic = v_nom * (1.0 + (alpha * p_net) + sensor_noise)
        node['sim_measured_voltage'] = round(float(np.clip(v_dynamic, v_nom * 0.90, v_nom * 1.10)), 2)

    for line in grid.lines:
        if line.get('status', 'ACTIVE') != 'ACTIVE':
            line['p_flow'] = line['q_flow'] = line['s_flow'] = line['p_loss'] = 0.0
            continue
        if line['source'] in grid.nodes and line['target'] in grid.nodes:
            source = grid.nodes[line['source']]
            target = grid.nodes[line['target']]
            line['p_flow'] = source['sim_active_power'] if source['sim_active_power'] > 0 else target['sim_active_power']
            line['q_flow'] = source['sim_reactive_power'] if source['sim_reactive_power'] > 0 else target['sim_reactive_power']
            line['s_flow'] = np.sqrt(line['p_flow'] ** 2 + line['q_flow'] ** 2)
            I = (line['s_flow'] * 1e6) / (np.sqrt(3) * source['sim_measured_voltage'] * 1e3) if line['s_flow'] > 0 else 0.0
            line['p_loss'] = (3 * (I ** 2) * line['R']) / 1e6
            total_losses += line['p_loss']
            if source['sim_measured_voltage'] > 0 and line['s_flow'] > 0:
                v_drop = (line['p_flow'] * line['R'] + line['q_flow'] * line['X']) / source['sim_measured_voltage']
                target['sim_measured_voltage'] = max(1.0, target['sim_measured_voltage'] - v_drop)
                target['sim_measured_current'] = I
    return total_losses


def process_telemetry_physics(grid, time_step, control_actions):
    total_generation = 0.0
    total_demand = 0.0
    hour = (time_step // 5) % 24
    load_profile_factor = 1.3 if (18 <= hour <= 22) else 0.8

    for node_id, node in grid.nodes.items():
        if node['type'] in ['Residential', 'Industrial']:
            factor = load_profile_factor if node['type'] == 'Residential' else 1.0
            factor *= control_actions.get('load_shedding_factor', 1.0)
            if control_actions.get('demand_response') and node['has_smart_appliances']:
                factor *= 0.90
            load_noise = sample(node_id, 'load_noise')
            node['sim_active_power'] = node['demand_mw'] * factor * (1.0 + load_noise)
            node['sim_reactive_power'] = node['sim_active_power'] * np.tan(np.arccos(node['power_factor']))
            total_demand += node['sim_active_power']

    res_generation = 0.0
    for node_id, node in grid.nodes.items():
        if node['type'] == 'SolarPark':
            import random as _random
            raw_cloud_cover = np.clip(_random.uniform(0.1, 0.4) + sample(node_id, 'solar_noise'), 0.0, 1.0)
            prev_cloud = node['_cloud_state'] if node['_cloud_state'] is not None else raw_cloud_cover
            cloud_cover = prev_cloud + WEATHER_SMOOTHING_ALPHA * (raw_cloud_cover - prev_cloud)
            node['_cloud_state'] = cloud_cover
            node['sim_active_power'] = node['max_capacity_mw'] * (1.0 - cloud_cover) * 0.75
            node['sim_reactive_power'] = 0.0
            res_generation += node['sim_active_power']
        elif node['type'] == 'WindFarm':
            raw_wind_speed = sample(node_id, 'wind_speed', default=7.0)
            prev_wind = node['_wind_state'] if node['_wind_state'] is not None else raw_wind_speed
            wind_speed = prev_wind + WEATHER_SMOOTHING_ALPHA * (raw_wind_speed - prev_wind)
            node['_wind_state'] = wind_speed
            if wind_speed < 3.0 or wind_speed > 25.0:
                node['sim_active_power'] = 0.0
            elif wind_speed >= 13.0:
                node['sim_active_power'] = node['max_capacity_mw']
            else:
                node['sim_active_power'] = node['max_capacity_mw'] * ((wind_speed - 3.0) / 10.0) ** 3
            node['sim_reactive_power'] = node['sim_active_power'] * np.tan(np.arccos(node['power_factor']))
            res_generation += node['sim_active_power']
        elif node['type'] == 'BatteryStorage':
            p_batt = control_actions.get('battery_power', 0.0)
            if node['state_of_charge'] >= 1.0 and p_batt > 0:
                p_batt = 0.0
            if node['state_of_charge'] <= 0.0 and p_batt < 0:
                p_batt = 0.0
            node['sim_active_power'] = p_batt
            eff = 0.95
            batt_cap = node['max_capacity_mw'] if node['max_capacity_mw'] > 0 else 5.0
            soc_noise = sample(node_id, 'soc_noise')
            if p_batt > 0:
                node['state_of_charge'] += (p_batt * eff) / (batt_cap * 3600.0) + soc_noise
            else:
                node['state_of_charge'] += (p_batt / eff) / (batt_cap * 3600.0) + soc_noise
            node['state_of_charge'] = np.clip(node['state_of_charge'], 0.0, 1.0)
            if p_batt > 0:
                total_demand += p_batt
            else:
                res_generation += abs(p_batt)

    total_generation += res_generation
    required_thermal = max(0.0, total_demand - res_generation)

    for node_id, node in grid.nodes.items():
        if node['type'] == 'ThermalPlant':
            if control_actions.get('curtail_thermal'):
                node['sim_active_power'] = min(required_thermal, node['max_capacity_mw'] * 0.1)
            else:
                node['sim_active_power'] = np.clip(required_thermal, node['max_capacity_mw'] * 0.05, node['max_capacity_mw'])
            node['sim_reactive_power'] = node['sim_active_power'] * np.tan(np.arccos(node['power_factor']))
            total_generation += node['sim_active_power']

    total_losses = compute_line_flows(grid)
    mismatch = total_generation - total_demand - total_losses
    delta_f = grid.frequency - FREQUENCY_NOMINAL
    damping_term = FREQUENCY_DAMPING_D * grid.p_rated * delta_f
    effective_mismatch = mismatch - damping_term
    df_dt = (grid.frequency / (2 * grid.inertia_H)) * (effective_mismatch / grid.p_rated)
    grid.frequency += df_dt
    grid.frequency = max(35.0, min(65.0, grid.frequency))

    for node_id, node in grid.nodes.items():
        if node['type'] == 'SubStation':
            node['congestion_level'] = float(np.clip(total_generation / (grid.p_rated * 0.8), 0.0, 1.2))


def compute_local_control_actions(grid):
    """Τοπικός (edge-side) βρόχος ελέγχου κλειστού βρόχου: batter dispatch,
    load shedding. ΔΕΝ γράφει alerts πουθενά — μόνο επιστρέφει εντολές για το
    επόμενο physics step. Η καταγραφή/ταξινόμηση ανωμαλιών γίνεται downstream
    στο analytics_consumer.py πάνω στο ήδη-δημοσιευμένο telemetry.

    CONTROL_MODE=observe: καμία διορθωτική ενέργεια (ούτε τοπική, ούτε
    supervisory override) — χρήσιμο όταν θέλεις οι ανωμαλίες να ΠΑΡΑΜΕΝΟΥΝ
    και να ανιχνεύονται/καταγράφονται, αντί να "διορθώνονται" σιωπηλά πριν
    προλάβουν να εμφανιστούν ως alert."""
    actions = {'battery_power': 0.0, 'demand_response': False, 'curtail_thermal': False, 'load_shedding_factor': 1.0}

    if CONTROL_MODE == "observe":
        return actions

    if grid.frequency < QUALITY_THRESHOLD_LOW_F:
        actions['battery_power'] = -(grid.p_rated * 0.25)
        if grid.frequency < 49.0:
            actions['load_shedding_factor'] = 0.40
    elif grid.frequency > 50.05:
        actions['battery_power'] = grid.p_rated * 0.15

    for node in grid.nodes.values():
        if node['type'] == 'SubStation' and node['congestion_level'] > 0.85:
            actions['demand_response'] = True
            actions['curtail_thermal'] = True

    apply_supervisory_override(actions)
    return actions


def apply_supervisory_override(actions):
    """Επικαλύπτει (override) τον τοπικό έλεγχο με μια πρόσφατη supervisory
    εντολή του Analytics Consumer, αν υπάρχει και δεν έχει λήξει το TTL της.
    Αυτό ΔΕΝ αντικαθιστά τον γρήγορο τοπικό βρόχο — απλά επιτρέπει σε μια πιο
    αργή, εποπτική απόφαση (π.χ. από συνεχόμενα CRITICAL alerts) να επηρεάσει
    την επόμενη προσομοίωση, χωρίς να χρειάζεται ο edge να περιμένει το Kafka
    round-trip σε κάθε βήμα — απλά διαβάζει την τελευταία γνωστή τιμή."""
    cmd = _latest_supervisory_command
    age = time.time() - cmd["received_at"]
    if cmd["command"] is None or age > SUPERVISORY_COMMAND_TTL_S:
        return
    if cmd["command"] == "force_load_shedding":
        actions['load_shedding_factor'] = min(actions.get('load_shedding_factor', 1.0), cmd["factor"])
    elif cmd["command"] == "force_curtail_thermal":
        actions['curtail_thermal'] = True
        actions['demand_response'] = True


GENERATION_LABELS = {
    'ThermalPlant': 'Gen', 'SolarPark': 'Gen', 'WindFarm': 'Gen',
    'Residential': 'Load', 'Industrial': 'Load',
    'BatteryStorage': 'Batt', 'SubStation': 'Sub',
}
SHOW_DIST_INFO = os.environ.get("SHOW_DIST_INFO", "0") == "1"


def dist_source_summary(node_id):
    """Επιστρέφει compact σύνοψη της προέλευσης κάθε κατανομής θορύβου του
    κόμβου, π.χ. 'solar_noise=global, voltage_noise=default' — χρήσιμο μόνο
    για debugging, γι' αυτό κρύβεται πίσω από SHOW_DIST_INFO=1."""
    dists = NODE_DISTRIBUTIONS.get(node_id, {})
    return ", ".join(f"{var}={cfg['source']}" for var, cfg in dists.items())


def _signed_power(node):
    """Θετικό πρόσημο για παραγωγή/έγχυση, αρνητικό για κατανάλωση, ώστε να
    φαίνεται με μια ματιά αν ο κόμβος τροφοδοτεί ή καταναλώνει το δίκτυο."""
    p = node['sim_active_power']
    if node['type'] in ('Residential', 'Industrial'):
        return -abs(p)
    return p


def print_node_telemetry(grid, step):
    now_str = datetime.now().strftime("%H:%M:%S")
    header = f" Step {step:>4}  |  {now_str}  |  Freq: {grid.frequency:6.2f} Hz  |  {len(grid.nodes)} nodes"
    rule = "-" * max(len(header), 70)
    print(rule)
    print(header)
    print(rule)
    print(f" {'Node':<16}{'Type':<9}{'Power (MW)':>12}{'Voltage (kV)':>14}{'Cong.':>8}")
    for node_id, node in grid.nodes.items():
        label = GENERATION_LABELS.get(node['type'], node['type'][:4])
        power = _signed_power(node)
        cong = f"{node['congestion_level']:.2f}" if node['type'] == 'SubStation' else "-"
        print(f" {node_id:<16}{label:<9}{power:>+12.2f}{node['sim_measured_voltage']:>14.2f}{cong:>8}")
        if SHOW_DIST_INFO:
            print(f"   dist[{dist_source_summary(node_id)}]")
    print(rule)


GENERATION_TYPES = ('ThermalPlant', 'SolarPark', 'WindFarm')


def _is_source_node(node):
    if node['type'] in GENERATION_TYPES and node['sim_active_power'] > 0:
        return True
    if node['type'] == 'BatteryStorage' and node['sim_active_power'] > 0:
        return True
    return False


def build_adjacency(grid):
    adjacency = {node_id: [] for node_id in grid.nodes}
    for line in grid.lines:
        if line.get('status', 'ACTIVE') != 'ACTIVE':
            continue
        s, t = line['source'], line['target']
        if s in grid.nodes and t in grid.nodes:
            adjacency.setdefault(s, []).append((t, line))
            adjacency.setdefault(t, []).append((s, line))
    return adjacency


def find_isolated_consumers(grid):
    adjacency = build_adjacency(grid)
    visited = set()
    frontier = [n_id for n_id, n in grid.nodes.items() if _is_source_node(n)]
    visited.update(frontier)
    while frontier:
        next_frontier = []
        for n_id in frontier:
            for neighbour_id, _line in adjacency.get(n_id, []):
                if neighbour_id not in visited:
                    visited.add(neighbour_id)
                    next_frontier.append(neighbour_id)
        frontier = next_frontier
    return [
        n_id for n_id, n in grid.nodes.items()
        if n_id not in visited and n['type'] in ('Residential', 'Industrial', 'SubStation')
    ]


def simulate_cascading_failure(grid, initial_failed_line_ids, mqtt_client=None, max_rounds=10):
    lines_by_id = {line['id']: line for line in grid.lines}
    failed = set()
    for line_id in initial_failed_line_ids:
        if line_id in lines_by_id:
            lines_by_id[line_id]['status'] = 'FAILED'
            failed.add(line_id)
            publish_event(mqtt_client, "LINE_FAILED", {"line_id": line_id, "cause": "manual_trigger"})

    rounds = []
    for round_num in range(max_rounds):
        compute_line_flows(grid)
        overloaded = [
            line for line in grid.lines
            if line.get('status', 'ACTIVE') == 'ACTIVE' and line['s_flow'] > line['max_capacity_mw'] > 0
        ]
        if not overloaded:
            break
        newly_failed = [line['id'] for line in overloaded]
        for line in overloaded:
            line['status'] = 'FAILED'
            publish_event(mqtt_client, "CASCADING_LINE_FAILURE", {"line_id": line['id'], "s_flow": line['s_flow']})
        failed.update(newly_failed)
        rounds.append({'round': round_num, 'newly_failed_lines': newly_failed})

    compute_line_flows(grid)
    isolated_nodes = find_isolated_consumers(grid)
    for node_id in isolated_nodes:
        publish_event(mqtt_client, "NODE_ISOLATED", {"node_id": node_id, "cause": "no_path_to_generation"})

    return {
        'initial_failed_lines': list(initial_failed_line_ids),
        'rounds': rounds,
        'total_failed_lines': sorted(failed),
        'isolated_nodes': isolated_nodes,
    }


# ---------------------------------------------------------------------------
# MQTT publishing (n7 -> n8 στο διάγραμμα)
# ---------------------------------------------------------------------------

def on_supervisory_message(client, userdata, msg):
    try:
        payload = json.loads(msg.payload.decode("utf-8"))
        _latest_supervisory_command["command"] = payload.get("command")
        _latest_supervisory_command["factor"] = payload.get("factor")
        _latest_supervisory_command["received_at"] = time.time()
        print(f"  [supervisory] received: {payload.get('command')} (factor={payload.get('factor')}, reason={payload.get('reason')})")
    except (ValueError, KeyError) as exc:
        print(f"  [supervisory] malformed command ignored: {exc}")


def make_mqtt_client():
    client = mqtt.Client(client_id=f"edge-simulator-{{ project_slug }}", protocol=mqtt.MQTTv5)
    client.on_message = on_supervisory_message
    client.connect(MQTT_HOST, MQTT_PORT, keepalive=30)
    client.subscribe(MQTT_COMMANDS_TOPIC, qos=1)
    client.loop_start()
    return client


def publish_telemetry(client, grid, timestamp_str):
    for node_id, node in grid.nodes.items():
        payload = {
            'timestamp': timestamp_str,
            'grid_name': grid.grid_name,
            'node_id': node_id,
            'node_type': node['type'],
            'frequency': grid.frequency,
            'active_power': node['sim_active_power'],
            'reactive_power': node['sim_reactive_power'],
            'voltage': node['sim_measured_voltage'],
            'congestion_level': node['congestion_level'],
            'state_of_charge': node['state_of_charge'],
        }
        client.publish(f"{MQTT_TOPIC_PREFIX}/{node_id}", json.dumps(payload), qos=1)


def publish_event(client, event_type, payload):
    if client is None:
        return
    message = {
        'timestamp': datetime.now(timezone.utc).isoformat(),
        'grid_name': "{{ grid_name }}",
        'event_type': event_type,
        **payload,
    }
    client.publish(MQTT_EVENTS_TOPIC, json.dumps(message), qos=1)


if __name__ == "__main__":
    grid = build_topology()
    client = make_mqtt_client()

    if len(sys.argv) > 1 and sys.argv[1] == "--fail-line":
        target_lines = sys.argv[2:]
        process_telemetry_physics(grid, 0, {})
        report = simulate_cascading_failure(grid, target_lines, mqtt_client=client)
        print(f"=== Cascading Failure Report ({grid.grid_name}) ===")
        print(f"Initial Failed Lines: {report['initial_failed_lines']}")
        for r in report['rounds']:
            print(f"  Round {r['round']}: Cascading Overload Failures: {r['newly_failed_lines']}")
        print(f"Total Failed Lines: {report['total_failed_lines']}")
        print(f"Blackout Nodes: {report['isolated_nodes']}")
        sys.exit(0)

    control_actions = {}
    step = 0
    sampling_period_s = SAMPLING_RATE_MS / 1000.0
    next_tick = time.monotonic() + sampling_period_s
    try:
        while True:
            process_telemetry_physics(grid, step, control_actions)
            control_actions = compute_local_control_actions(grid)

            timestamp_str = datetime.now(timezone.utc).isoformat()
            publish_telemetry(client, grid, timestamp_str)
            print_node_telemetry(grid, step)

            step += 1
            sleep_for = next_tick - time.monotonic()
            if sleep_for > 0:
                time.sleep(sleep_for)
            else:
                # Ο υπολογισμός πήρε παραπάνω από το διαθέσιμο διάστημα — δεν
                # προλαβαίνουμε, προχωράμε αμέσως χωρίς να "τρέξουμε" να
                # προλάβουμε τα χαμένα ticks (θα ήταν χειρότερο).
                print(f"  [warn] step {step-1} took longer than {sampling_period_s:.1f}s (drift {-sleep_for:.2f}s)")
            next_tick += sampling_period_s
    except KeyboardInterrupt:
        client.loop_stop()
        client.disconnect()
