"""
persistence_consumer.py  (auto-generated by generate_twin.py)

Ρόλος στο διάγραμμα: n11 "PERSISTENCE CONSUMER — Time-Series Ingestion Service".
Καταναλώνει από το Kafka topic "{{ kafka_topic_raw }}" (που τροφοδοτείται από
το Kafka Connect MQTT Source Connector, βλ. kafka-connect/mqtt-source-connector.json)
και κάνει batch insert σε TimescaleDB hypertable telemetry_metrics_raw.
"""

import json
import os
import time

import psycopg2
import psycopg2.extras
from kafka import KafkaConsumer

KAFKA_BOOTSTRAP_SERVERS = os.environ.get("KAFKA_BOOTSTRAP_SERVERS", "localhost:9092")
KAFKA_TOPIC = "{{ kafka_topic_raw }}"
KAFKA_GROUP_ID = "persistence-consumer-{{ project_slug }}"

TIMESCALE_DSN = os.environ.get(
    "TIMESCALE_DSN",
    "host=localhost port=5432 dbname=smartgrid_dt user=dt_user password=dt_password",
)

BATCH_SIZE = int(os.environ.get("PERSISTENCE_BATCH_SIZE", "50"))
BATCH_FLUSH_INTERVAL_S = float(os.environ.get("PERSISTENCE_FLUSH_INTERVAL_S", "5.0"))

INSERT_SQL = """
    INSERT INTO telemetry_metrics_raw
        (timestamp, node_id, node_type, frequency, active_power, reactive_power,
         voltage, congestion_level, state_of_charge)
    VALUES %s
"""


def to_row(payload):
    return (
        payload['timestamp'],
        payload['node_id'],
        payload.get('node_type'),
        payload.get('frequency'),
        payload.get('active_power'),
        payload.get('reactive_power'),
        payload.get('voltage'),
        payload.get('congestion_level'),
        payload.get('state_of_charge'),
    )


def safe_json_deserialize(raw_bytes):
    """Βλ. αντίστοιχο σχόλιο στο analytics_consumer.py: η αποκωδικοποίηση
    πρέπει να είναι ασφαλής εδώ (όχι στο for-loop), αλλιώς ένα και μόνο
    χαλασμένο μήνυμα (π.χ. legacy backlog από πριν διορθωθεί ο connector)
    τερματίζει ολόκληρο τον consumer."""
    try:
        return json.loads(raw_bytes.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError, AttributeError) as exc:
        print(f"[persistence_consumer] skipping malformed message ({exc})")
        return None


def main():
    consumer = KafkaConsumer(
        KAFKA_TOPIC,
        bootstrap_servers=KAFKA_BOOTSTRAP_SERVERS,
        group_id=KAFKA_GROUP_ID,
        value_deserializer=safe_json_deserialize,
        auto_offset_reset="latest",
        enable_auto_commit=True,
    )

    conn = psycopg2.connect(TIMESCALE_DSN)
    conn.autocommit = False

    buffer = []
    last_flush = time.monotonic()
    print(f"[persistence_consumer] listening on '{KAFKA_TOPIC}' -> TimescaleDB ...")

    try:
        for message in consumer:
            if message.value is None:
                continue
            buffer.append(to_row(message.value))
            now = time.monotonic()
            if len(buffer) >= BATCH_SIZE or (now - last_flush) >= BATCH_FLUSH_INTERVAL_S:
                if buffer:
                    with conn.cursor() as cur:
                        psycopg2.extras.execute_values(cur, INSERT_SQL, buffer)
                    conn.commit()
                    print(f"[persistence_consumer] batch inserted {len(buffer)} rows")
                    buffer = []
                last_flush = now
    except KeyboardInterrupt:
        pass
    finally:
        if buffer:
            with conn.cursor() as cur:
                psycopg2.extras.execute_values(cur, INSERT_SQL, buffer)
            conn.commit()
        conn.close()
        consumer.close()


if __name__ == "__main__":
    main()
