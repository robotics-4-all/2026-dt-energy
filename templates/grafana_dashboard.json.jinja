{% set ns = namespace(y=0, x=0, panel_id=1) -%}
{
  "uid": "digital-twin",
  "title": "Digital Twin — {{ grid_name | jsonesc }}",
  "description": "Auto-generated by generate_twin.py. Telemetry + anomaly detection dashboard for grid \"{{ grid_name | jsonesc }}\" ({{ grid_region | jsonesc }}).",
  "tags": ["digital-twin", "{{ project_slug }}", "auto-generated"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": {{ ns.panel_id }}, "type": "row", "title": "Τοπολογία και κατάσταση κόμβων (live) — κόκκινο = alert ανίχνευσης στην τάση", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": {{ ns.y }}}, "panels": []}
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 1 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "nodeGraph",
      "title": "Τοπολογία δικτύου — ο κόμβος γίνεται κόκκινος όταν ο ανιχνευτής σηκώσει alert (τελευταία 60 s)",
      "description": "Πράσινο = OK, κίτρινο = προειδοποίηση (p1: ένα δείγμα πάνω από το όριο), κόκκινο = ALERT (p2: δύο συνεχόμενα δείγματα). Βάσει του πίνακα voltage_zscore_eval.",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 10, "w": 16, "x": 0, "y": {{ ns.y }}},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {"matcher": {"id": "byName", "options": "arc__ok"},    "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byName", "options": "arc__warn"},  "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
          {"matcher": {"id": "byName", "options": "arc__alert"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {"nodes": {"mainStatUnit": "none", "secondaryStatUnit": "none"}, "edges": {}},
      "targets": [
        {
          "refId": "nodes",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH nodes(id, ntype) AS (VALUES {% for n in node_summaries %}('{{ n.id | replace("'", "''") | jsonesc }}', '{{ n.type }}'){% if not loop.last %}, {% endif %}{% endfor %}), recent AS (SELECT node_id, bool_or(predicted_p2) AS p2, bool_or(predicted_p1) AS p1, max(z_score) AS zmax FROM voltage_zscore_eval WHERE \"timestamp\" > now() - interval '60 seconds' GROUP BY node_id) SELECT n.id AS id, n.id AS title, n.ntype AS \"subTitle\", ROUND(COALESCE(r.zmax, 0)::numeric, 1) AS \"mainStat\", CASE WHEN r.p2 THEN 'ALERT' WHEN r.p1 THEN 'WARN' ELSE 'OK' END AS \"detail__status\", (CASE WHEN r.p2 THEN 1 ELSE 0 END)::float AS arc__alert, (CASE WHEN r.p2 THEN 0 WHEN r.p1 THEN 1 ELSE 0 END)::float AS arc__warn, (CASE WHEN r.p2 OR r.p1 THEN 0 ELSE 1 END)::float AS arc__ok FROM nodes n LEFT JOIN recent r ON r.node_id = n.id"
        },
        {
          "refId": "edges",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT id, source, target FROM (VALUES {% for l in all_lines %}('{{ l.id | replace("'", "''") | jsonesc }}', '{{ l.source | replace("'", "''") | jsonesc }}', '{{ l.target | replace("'", "''") | jsonesc }}'){% if not loop.last %}, {% endif %}{% endfor %}) AS e(id, source, target)"
        }
      ]
    }
    {%- set ns.panel_id = ns.panel_id + 1 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "stat",
      "title": "Κατάσταση ανά κόμβο (τελευταία 60 s)",
      "description": "Ένα πλακίδιο ανά κόμβο: OK / WARN (p1) / ALERT (p2).",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": {{ ns.y }}},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [{"type": "value", "options": {
            "0": {"text": "OK", "color": "green"},
            "1": {"text": "WARN", "color": "yellow"},
            "2": {"text": "ALERT", "color": "red"}}}],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 2}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"values": true, "calcs": ["lastNotNull"], "fields": "/^status_code$/"},
        "colorMode": "background", "graphMode": "none", "textMode": "value_and_name",
        "orientation": "auto", "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH nodes(id) AS (VALUES {% for n in node_summaries %}('{{ n.id | replace("'", "''") | jsonesc }}'){% if not loop.last %}, {% endif %}{% endfor %}), recent AS (SELECT node_id, bool_or(predicted_p2) AS p2, bool_or(predicted_p1) AS p1 FROM voltage_zscore_eval WHERE \"timestamp\" > now() - interval '60 seconds' GROUP BY node_id) SELECT n.id AS node, CASE WHEN r.p2 THEN 2 WHEN r.p1 THEN 1 ELSE 0 END AS status_code FROM nodes n LEFT JOIN recent r ON r.node_id = n.id ORDER BY n.id"
        }
      ]
    }
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 10 %}
    ,
    {"id": {{ ns.panel_id }}, "type": "row", "title": "Δίκτυο — {{ grid_name | jsonesc }} (network-wide)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": {{ ns.y }}}, "panels": []}
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 1 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "timeseries",
      "title": "Frequency (Hz) — network-wide",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": {{ ns.y }}},
      "fieldConfig": {"defaults": {"unit": "hertz"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT \"timestamp\" AS \"time\", AVG(frequency) AS \"Frequency\" FROM telemetry_metrics_raw WHERE $__timeFilter(\"timestamp\") GROUP BY \"timestamp\" ORDER BY 1"
        }
      ]
    }
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 8 -%}
    {%- set ns.x = 0 %}

    {% for row in dashboard_rows %}
    ,
    {"id": {{ ns.panel_id }}, "type": "row", "title": "Κατανομή: {{ row.distribution_type }}", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": {{ ns.y }}}, "panels": []}
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 1 -%}
    {%- set ns.x = 0 %}
    {% for p in row.panels %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "timeseries",
      "title": "{{ p.node_id | jsonesc }} · {{ p.variable }} ({{ row.distribution_type }}, {% for k, v in p.params.items() %}{{ k }}={{ v }}{% if not loop.last %}, {% endif %}{% endfor %}, source={{ p.source }})",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 8, "w": 12, "x": {{ ns.x }}, "y": {{ ns.y }}},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT \"timestamp\" AS \"time\", {{ p.column }} AS \"{{ p.node_id | jsonesc }}\" FROM telemetry_metrics_raw WHERE node_id = '{{ p.node_id | jsonesc }}' AND $__timeFilter(\"timestamp\") ORDER BY 1"
        }
      ]
    }
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- if ns.x == 0 -%}
      {%- set ns.x = 12 -%}
    {%- else -%}
      {%- set ns.x = 0 -%}
      {%- set ns.y = ns.y + 8 -%}
    {%- endif %}
    {% endfor %}
    {%- if ns.x != 0 -%}
      {%- set ns.y = ns.y + 8 -%}
      {%- set ns.x = 0 -%}
    {%- endif %}
    {% endfor %}

    {% if dashboard_inactive_distributions %}
    ,
    {"id": {{ ns.panel_id }}, "type": "row", "title": "Ρυθμισμένες αλλά μη ενεργές παράμετροι", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": {{ ns.y }}}, "panels": []}
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 1 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "text",
      "title": "⚠ Μη εφαρμοσμένες κατανομές",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": {{ ns.y }}},
      "options": {
        "mode": "markdown",
        "content": "Οι παρακάτω μεταβλητές έχουν επιλυμένη κατανομή στο .seg, αλλά ο edge_simulator.py δεν τις δειγματοληπτεί — δεν επηρεάζουν καμία στήλη τηλεμετρίας σήμερα:\n\n{% for e in dashboard_inactive_distributions %}- **{{ e.node_id | jsonesc }}** · `{{ e.variable }}` → {{ e.type }}({% for k, v in e.params.items() %}{{ k }}={{ v }}{% if not loop.last %}, {% endif %}{% endfor %}), source={{ e.source }}\n{% endfor %}"
      }
    }
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 6 %}
    {% endif %}

    ,
    {"id": {{ ns.panel_id }}, "type": "row", "title": "Μοντέλο ανίχνευσης — Modified Z-score (voltage)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": {{ ns.y }}}, "panels": []}
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 1 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "timeseries",
      "title": "Z-score τάσης ανά κόμβο (live)",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": {{ ns.y }}},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "thresholds"},
          "custom": {
            "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0,
            "pointSize": 3, "showPoints": "auto",
            "thresholdsStyle": {"mode": "line"}
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 2.0},
              {"color": "red", "value": 3.5}
            ]
          }
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT \"timestamp\" AS \"time\", node_id AS \"metric\", z_score AS \"value\" FROM voltage_zscore_eval WHERE $__timeFilter(\"timestamp\") ORDER BY 1"
        }
      ]
    }
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 9 %}

    ,
    {
      "id": {{ ns.panel_id }},
      "type": "table",
      "title": "Z-score τάσης ανά κόμβο — αναλυτικά δεδομένα",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": {{ ns.y }}},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT \"timestamp\" AS \"time\", node_id, z_score, predicted_p2, predicted_p1 FROM voltage_zscore_eval WHERE $__timeFilter(\"timestamp\") ORDER BY \"timestamp\" DESC LIMIT 500"
        }
      ]
    }
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 8 %}

    ,
    {"id": {{ ns.panel_id }}, "type": "row", "title": "Ανίχνευση Ανωμαλιών", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": {{ ns.y }}}, "panels": []}
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 1 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "stat",
      "title": "LOW alerts",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": {{ ns.y }}},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "green"}}, "overrides": []},
      "targets": [{"refId": "A",
          "editorMode": "code",
          "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS \"LOW\" FROM digital_twin_alerts WHERE severity_level = 'LOW' AND $__timeFilter(\"timestamp\")"}]
    }
    {%- set ns.panel_id = ns.panel_id + 1 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "stat",
      "title": "MEDIUM alerts",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": {{ ns.y }}},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "orange"}}, "overrides": []},
      "targets": [{"refId": "A",
          "editorMode": "code",
          "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS \"MEDIUM\" FROM digital_twin_alerts WHERE severity_level = 'MEDIUM' AND $__timeFilter(\"timestamp\")"}]
    }
    {%- set ns.panel_id = ns.panel_id + 1 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "stat",
      "title": "HIGH alerts",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": {{ ns.y }}},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "red"}}, "overrides": []},
      "targets": [{"refId": "A",
          "editorMode": "code",
          "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS \"HIGH\" FROM digital_twin_alerts WHERE severity_level = 'HIGH' AND $__timeFilter(\"timestamp\")"}]
    }
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 4 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "table",
      "title": "Πρόσφατα Alerts",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": {{ ns.y }}},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT \"timestamp\" AS \"time\", node_id, anomaly_type, severity, severity_level, function_name, control_action, action_value FROM digital_twin_alerts WHERE $__timeFilter(\"timestamp\") ORDER BY \"timestamp\" DESC LIMIT 200"
        }
      ]
    }
  ]
}
