{% set ns = namespace(y=0, x=0, panel_id=1) -%}
{
  "uid": "digital-twin",
  "title": "Digital Twin \u2014 {{ grid_name | jsonesc }}",
  "description": "Auto-generated by generate_twin.py. Telemetry + anomaly detection dashboard for grid \"{{ grid_name | jsonesc }}\" ({{ grid_region | jsonesc }}).",
  "tags": ["digital-twin", "{{ project_slug }}", "auto-generated"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": {{ ns.panel_id }}, "type": "row", "title": "\u0394\u03af\u03ba\u03c4\u03c5\u03bf \u2014 {{ grid_name | jsonesc }} (network-wide)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": {{ ns.y }}}, "panels": []}
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 1 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "timeseries",
      "title": "Frequency (Hz) \u2014 network-wide",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": {{ ns.y }}},
      "fieldConfig": {"defaults": {"unit": "hertz"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT \"timestamp\" AS \"time\", AVG(frequency) AS \"Frequency\" FROM telemetry_metrics_raw WHERE $__timeFilter(\"timestamp\") GROUP BY \"timestamp\" ORDER BY 1"
        }
      ]
    }
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 8 -%}
    {%- set ns.x = 0 %}

    {% for row in dashboard_rows %}
    ,
    {"id": {{ ns.panel_id }}, "type": "row", "title": "\u039a\u03b1\u03c4\u03b1\u03bd\u03bf\u03bc\u03ae: {{ row.distribution_type }}", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": {{ ns.y }}}, "panels": []}
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 1 -%}
    {%- set ns.x = 0 %}
    {% for p in row.panels %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "timeseries",
      "title": "{{ p.node_id | jsonesc }} \u00b7 {{ p.variable }} ({{ row.distribution_type }}, {% for k, v in p.params.items() %}{{ k }}={{ v }}{% if not loop.last %}, {% endif %}{% endfor %}, source={{ p.source }})",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 8, "w": 12, "x": {{ ns.x }}, "y": {{ ns.y }}},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT \"timestamp\" AS \"time\", {{ p.column }} AS \"{{ p.node_id | jsonesc }}\" FROM telemetry_metrics_raw WHERE node_id = '{{ p.node_id | jsonesc }}' AND $__timeFilter(\"timestamp\") ORDER BY 1"
        }
      ]
    }
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- if ns.x == 0 -%}
      {%- set ns.x = 12 -%}
    {%- else -%}
      {%- set ns.x = 0 -%}
      {%- set ns.y = ns.y + 8 -%}
    {%- endif %}
    {% endfor %}
    {%- if ns.x != 0 -%}
      {%- set ns.y = ns.y + 8 -%}
      {%- set ns.x = 0 -%}
    {%- endif %}
    {% endfor %}

    {% if dashboard_inactive_distributions %}
    ,
    {"id": {{ ns.panel_id }}, "type": "row", "title": "\u03a1\u03c5\u03b8\u03bc\u03b9\u03c3\u03bc\u03ad\u03bd\u03b5\u03c2 \u03b1\u03bb\u03bb\u03ac \u03bc\u03b7 \u03b5\u03bd\u03b5\u03c1\u03b3\u03ad\u03c2 \u03c0\u03b1\u03c1\u03ac\u03bc\u03b5\u03c4\u03c1\u03bf\u03b9", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": {{ ns.y }}}, "panels": []}
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 1 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "text",
      "title": "\u26a0 \u039c\u03b7 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03c3\u03bc\u03ad\u03bd\u03b5\u03c2 \u03ba\u03b1\u03c4\u03b1\u03bd\u03bf\u03bc\u03ad\u03c2",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": {{ ns.y }}},
      "options": {
        "mode": "markdown",
        "content": "\u039f\u03b9 \u03c0\u03b1\u03c1\u03b1\u03ba\u03ac\u03c4\u03c9 \u03bc\u03b5\u03c4\u03b1\u03b2\u03bb\u03b7\u03c4\u03ad\u03c2 \u03ad\u03c7\u03bf\u03c5\u03bd \u03b5\u03c0\u03b9\u03bb\u03c5\u03bc\u03ad\u03bd\u03b7 \u03ba\u03b1\u03c4\u03b1\u03bd\u03bf\u03bc\u03ae \u03c3\u03c4\u03bf .seg, \u03b1\u03bb\u03bb\u03ac \u03bf edge_simulator.py \u03b4\u03b5\u03bd \u03c4\u03b9\u03c2 \u03b4\u03b5\u03b9\u03b3\u03bc\u03b1\u03c4\u03bf\u03bb\u03b7\u03c0\u03c4\u03b5\u03af \u2014 \u03b4\u03b5\u03bd \u03b5\u03c0\u03b7\u03c1\u03b5\u03ac\u03b6\u03bf\u03c5\u03bd \u03ba\u03b1\u03bc\u03af\u03b1 \u03c3\u03c4\u03ae\u03bb\u03b7 \u03c4\u03b7\u03bb\u03b5\u03bc\u03b5\u03c4\u03c1\u03af\u03b1\u03c2 \u03c3\u03ae\u03bc\u03b5\u03c1\u03b1:\n\n{% for e in dashboard_inactive_distributions %}- **{{ e.node_id | jsonesc }}** \u00b7 `{{ e.variable }}` \u2192 {{ e.type }}({% for k, v in e.params.items() %}{{ k }}={{ v }}{% if not loop.last %}, {% endif %}{% endfor %}), source={{ e.source }}\n{% endfor %}"
      }
    }
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 6 %}
    {% endif %}

    ,
    {"id": {{ ns.panel_id }}, "type": "row", "title": "\u0391\u03bd\u03af\u03c7\u03bd\u03b5\u03c5\u03c3\u03b7 \u0391\u03bd\u03c9\u03bc\u03b1\u03bb\u03b9\u03ce\u03bd", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": {{ ns.y }}}, "panels": []}
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 1 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "stat",
      "title": "LOW alerts",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": {{ ns.y }}},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "green"}}, "overrides": []},
      "targets": [{"refId": "A",
          "editorMode": "code",
          "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS \"LOW\" FROM digital_twin_alerts WHERE severity_level = 'LOW' AND $__timeFilter(\"timestamp\")"}]
    }
    {%- set ns.panel_id = ns.panel_id + 1 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "stat",
      "title": "MEDIUM alerts",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": {{ ns.y }}},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "orange"}}, "overrides": []},
      "targets": [{"refId": "A",
          "editorMode": "code",
          "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS \"MEDIUM\" FROM digital_twin_alerts WHERE severity_level = 'MEDIUM' AND $__timeFilter(\"timestamp\")"}]
    }
    {%- set ns.panel_id = ns.panel_id + 1 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "stat",
      "title": "HIGH alerts",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": {{ ns.y }}},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "red"}}, "overrides": []},
      "targets": [{"refId": "A",
          "editorMode": "code",
          "rawQuery": true, "format": "table", "rawSql": "SELECT count(*) AS \"HIGH\" FROM digital_twin_alerts WHERE severity_level = 'HIGH' AND $__timeFilter(\"timestamp\")"}]
    }
    {%- set ns.panel_id = ns.panel_id + 1 -%}
    {%- set ns.y = ns.y + 4 %}
    ,
    {
      "id": {{ ns.panel_id }},
      "type": "table",
      "title": "\u03a0\u03c1\u03cc\u03c3\u03c6\u03b1\u03c4\u03b1 Alerts",
      "datasource": {"type": "postgres", "uid": "timescaledb-dt"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": {{ ns.y }}},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT \"timestamp\" AS \"time\", node_id, anomaly_type, severity, severity_level, function_name, control_action, action_value FROM digital_twin_alerts WHERE $__timeFilter(\"timestamp\") ORDER BY \"timestamp\" DESC LIMIT 200"
        }
      ]
    }
  ]
}
