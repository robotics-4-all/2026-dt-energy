{
  "name": "{{ project_slug }}-mqtt-telemetry-source",
  "config": {
    "connector.class": "io.confluent.connect.mqtt.MqttSourceConnector",
    "tasks.max": "1",
    "mqtt.server.uri": "tcp://mosquitto:1883",
    "mqtt.topics": "{{ mqtt_topic_prefix }}/#",
    "kafka.topic": "{{ kafka_topic_raw }}",
    "confluent.topic.bootstrap.servers": "kafka:29092",
    "confluent.topic.replication.factor": "1",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.converters.ByteArrayConverter",
    "_comment_license": "Χωρίς confluent.license property, η Confluent παράγει αυτόματα 30-day trial license (βλ. README). Για μόνιμη χρήση μετά τις 30 μέρες χρειάζεται license key ή αλλαγή σε open-source εναλλακτική (π.χ. evokly/kafka-connect-mqtt)."
  }
}
