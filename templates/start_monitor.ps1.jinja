# start_monitor.ps1  (auto-generated by generate_twin.py)
#
# Starts all containers and automatically opens 2 separate windows with
# live logs: telemetry (edge-simulator) and anomalies (analytics-consumer).
#
# Usage:  .\start_monitor.ps1
# (First time you may need: Set-ExecutionPolicy -Scope CurrentUser RemoteSigned)

Write-Host "Starting all containers for {{ grid_name }}..." -ForegroundColor Cyan
docker compose up -d

Write-Host "Waiting 5 seconds for services to settle..." -ForegroundColor Cyan
Start-Sleep -Seconds 5

$here = $PSScriptRoot

Write-Host "Opening telemetry window (edge-simulator)..." -ForegroundColor Green
Start-Process powershell -ArgumentList @(
    "-NoExit",
    "-Command",
    "cd '$here'; docker compose logs -f --tail 0 edge-simulator"
)

Write-Host "Opening anomaly detection window (analytics-consumer)..." -ForegroundColor Green
Start-Process powershell -ArgumentList @(
    "-NoExit",
    "-Command",
    "cd '$here'; docker compose logs -f --tail 0 analytics-consumer"
)

Write-Host "Done! Grafana: http://localhost:3000" -ForegroundColor Yellow
