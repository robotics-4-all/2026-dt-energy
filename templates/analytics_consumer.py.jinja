# Πολυεπίπεδη (σταδιακή) αποκοπή φορτίου λόγω χαμηλής συχνότητας,
# κατ' αναλογία των πραγματικών σχημάτων UFLS (Underfrequency Load
# Shedding) που περιγράφει το Lakshminarayana et al. 2022 (arXiv:2201.10505)
# για ERCOT/NYISO/NERC. Το δικό μας δίκτυο είναι 50Hz (ευρωπαϊκό), ενώ τα
# ERCOT/NYISO αναφέρονται σε 60Hz σύστημα — μεταφέρουμε την ΑΝΑΛΟΓΙΚΗ
# απόκλιση (% από την ονομαστική τιμή), όχι τις απόλυτες τιμές Hz.
# Το ERCOT ξεκινά αποκοπή στο -1.17% της ονομαστικής συχνότητας (59.3/60),
# με επιπλέον στάδια στο -1.83% (58.9/60) και -2.5% (58.5/60), αποκόπτοντας
# διαδοχικά 5%, 10%, 10% του φορτίου.
NOMINAL_FREQUENCY_HZ = 50.0
FREQ_STAGE_1_HZ = 49.42   # ~ -1.17% (αναλογία ERCOT 59.3/60Hz) -> shed 5%
FREQ_STAGE_2_HZ = 49.09   # ~ -1.83% (αναλογία ERCOT 58.9/60Hz) -> shed +10%
FREQ_STAGE_3_HZ = 48.75   # ~ -2.5%  (αναλογία ERCOT 58.5/60Hz) -> shed +10%

# Όρια SOC μπαταρίας (overdischarge / overcharge). Βασισμένα σε τυπικά
# ασφαλή περιθώρια λειτουργίας BESS που αναφέρονται στη βιβλιογραφία
# (π.χ. Pang & Ohno 2025· BESS-Enabled Smart Grid Environments, 2025):
# η παραβίαση αυτών των ορίων λόγω overcharge/overdischarge είναι γνωστός
# προάγγελος βραχυκυκλωμάτων και thermal runaway.
SOC_CRITICAL_LOW = 0.10
SOC_WARNING_LOW = 0.20
SOC_WARNING_HIGH = 0.90
SOC_CRITICAL_HIGH = 0.95

# Στατιστικό όριο απόκλισης τάσης ανά κόμβο, βασισμένο σε rolling Modified
# Z-score (διάμεσος/MAD) πάνω σε κυλιόμενο παράθυρο (window) παρατηρήσεων.
# ΣΗΜΑΝΤΙΚΗ ΣΧΕΔΙΑΣΤΙΚΗ ΕΠΙΛΟΓΗ: χρησιμοποιούμε το εύρωστο Modified Z-score
# (median/MAD) αντί για το κλασικό Z-score (mean/SD) σε ΟΛΟΥΣ τους κόμβους,
# ανεξαρτήτως τύπου. Ο λόγος: η κατανομή θορύβου κάθε μεταβλητής δεν είναι
# σταθερή στον κώδικα — καθορίζεται δυναμικά ανά μοντέλο .seg μέσω της
# ιεραρχίας DistributionResolver (instance > class > global > default), και
# ο generator/analytics engine δεν έχει πρόσβαση σε αυτή την πληροφορία στο
# runtime. Για παράδειγμα, το wind_speed έχει default κατανομή Weibull (μη
# κανονική), και μέσω globalDistributions/classDistributions ένας χρήστης
# του DSL θα μπορούσε να ορίσει μη κανονικό θόρυβο και σε άλλες μεταβλητές/
# κόμβους. Το κλασικό Z-score (μ±3σ) προϋποθέτει κανονική κατανομή και η
# μέση τιμή/τυπική απόκλιση αλλοιώνονται εύκολα από ασύμμετρες κατανομές ή
# ακραίες τιμές. Το Modified Z-score, βασισμένο σε διάμεσο/MAD, παραμένει
# αξιόπιστο ανεξαρτήτως του σχήματος της υποκείμενης κατανομής, εξασφαλίζο-
# ντας ότι η ίδια λογική ανίχνευσης δουλεύει σωστά για ΟΠΟΙΟΔΗΠΟΤΕ .seg
# μοντέλο εισαχθεί στον generator, χωρίς να χρειάζεται προσαρμογή ανά
# τύπο κόμβου ή μεταβλητής (Pang et al. 2025· Hannon et al. 2019).
VOLTAGE_ZSCORE_WINDOW = 30       # πλήθος πρόσφατων δειγμάτων στο rolling window
VOLTAGE_ZSCORE_MIN_SAMPLES = 10  # ελάχιστα δείγματα πριν αξιολογηθεί το Modified
                                  # Z-score (αποφυγή τεχνητά μικρού MAD από λίγα,
                                  # τυχαία κοντινά δείγματα)
VOLTAGE_ZSCORE_MIN_STD_FRACTION = 0.005  # κατώτατο MAD ως κλάσμα της διαμέσου (0.5%),
                                  # ώστε φυσιολογικά "ήσυχες" περίοδοι να μην
                                  # παράγουν τεχνητά υπερευαίσθητο σκορ απόκλισης
VOLTAGE_MAD_FACTOR = 1.4826       # συντελεστής διόρθωσης F_MAD, ώστε το MAD να
                                  # είναι συγκρίσιμο με το σ σε κανονικές κατανομές
VOLTAGE_ZSCORE_WARNING = 2.0     # ήπια απόκλιση
VOLTAGE_ZSCORE_CRITICAL = 3.5    # Modified Z-score: |Z_mod|>3.5 (αντί για 3.0 στο
                                  # κλασικό Z-score, βλ. Pang et al. 2025)
VOLTAGE_PERSISTENCE_SAMPLES = 2  # απαιτούμενα συνεχόμενα δείγματα πάνω από το
                                  # όριο πριν καταγραφεί alert — αποτρέπει μεμονωμένες,
                                  # τυχαίες υπερβάσεις (θόρυβος) από το να ενεργοποιούν
                                  # alert, αφού με |Z|>2 περίπου 4.5% των φυσιολογικών
                                  # δειγμάτων θα το ξεπερνούν καθαρά τυχαία.

# Ταξινόμηση κάθε τύπου ανωμαλίας σε (επίπεδο σοβαρότητας, όνομα ελέγχου),
# για την τριβάθμια κλίμακα LOW/MEDIUM/HIGH και την ομαδοποίηση ανά "συνάρτηση"
