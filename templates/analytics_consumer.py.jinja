    "WARNING_HIGH_FREQUENCY":        ("LOW",    "Frequency Check"),
    "CRITICAL_LOW_FREQUENCY_STAGE1": ("MEDIUM", "Frequency Check"),
    "CRITICAL_LOW_FREQUENCY_STAGE2": ("HIGH",   "Frequency Check"),
    "CRITICAL_LOW_FREQUENCY_STAGE3": ("HIGH",   "Frequency Check"),
    "CRITICAL_CONGESTION":           ("HIGH",   "Congestion Check"),
    "WARNING_LOW_SOC":               ("LOW",    "SOC Check"),
    "CRITICAL_LOW_SOC":              ("HIGH",   "SOC Check"),
    "WARNING_HIGH_SOC":              ("LOW",    "SOC Check"),
    "CRITICAL_HIGH_SOC":             ("HIGH",   "SOC Check"),
    "WARNING_VOLTAGE_DEVIATION":     ("LOW",    "Voltage Check"),
    "CRITICAL_VOLTAGE_DEVIATION":    ("HIGH",   "Voltage Check"),
}


def classify_anomaly(anomaly_type):
    """Επιστρέφει (severity_level, function_name) για έναν τύπο ανωμαλίας.
    Άγνωστοι τύποι (π.χ. μελλοντική προσθήκη που ξεχάστηκε να καταχωρηθεί
    στο ANOMALY_METADATA) πέφτουν σε ασφαλές default, ώστε να μην σκάει
    ο κώδικας — απλά δεν θα ταξινομηθούν σωστά μέχρι να προστεθούν."""
    return ANOMALY_METADATA.get(anomaly_type, ("MEDIUM", "Unclassified Check"))


def init_db(path):
    conn = sqlite3.connect(path)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS digital_twin_alerts (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp TEXT NOT NULL,
            node_id TEXT NOT NULL,
            anomaly_type TEXT,
            severity TEXT,
            severity_level TEXT,
            function_name TEXT,
            control_action TEXT,
            action_value REAL
        )
    """)
    conn.commit()
    _migrate_sqlite_alerts_schema(conn)
    return conn


def _migrate_sqlite_alerts_schema(conn):
    """Το 'CREATE TABLE IF NOT EXISTS' παραπάνω δεν τροποποιεί έναν πίνακα
    που ήδη υπάρχει από παλιότερη έκδοση του κώδικα (π.χ. αποθηκευμένο σε
    persistent Docker volume από πριν προστεθούν οι στήλες severity_level/
    function_name). Εδώ ελέγχουμε ποιες στήλες υπάρχουν πραγματικά και
    προσθέτουμε όσες λείπουν, ώστε παλιές εγκαταστάσεις να αναβαθμίζονται
    αυτόματα χωρίς να χρειάζεται να διαγράψει κανείς χειροκίνητα το volume."""
    existing_columns = {row[1] for row in conn.execute("PRAGMA table_info(digital_twin_alerts)")}
    expected_columns = {
        "severity_level": "TEXT",
        "function_name": "TEXT",
    }
    for column, col_type in expected_columns.items():
        if column not in existing_columns:
            print(f"[analytics_consumer] migration: προσθήκη στήλης '{column}' στο digital_twin_alerts (SQLite).")
            conn.execute(f"ALTER TABLE digital_twin_alerts ADD COLUMN {column} {col_type}")
    conn.commit()


def init_timescale_alerts(dsn, retries=10, delay_s=3):
    """Δημιουργεί (αν δεν υπάρχει ήδη) το hypertable alerts, ΚΑΙ το hypertable
    voltage_zscore_eval (καταγραφή του z-score σε κάθε αξιολόγηση τάσης, όχι
    μόνο όταν σκάει alert — βλ. log_zscore_eval), στην ίδια TimescaleDB όπου
    γράφει ο persistence_consumer, ώστε το Grafana να τα βλέπει απευθείας
    μέσω του υπάρχοντος PostgreSQL data source. Με retry logic, αφού η
    TimescaleDB μπορεί να μην έχει προλάβει να ξεκινήσει ακόμα όταν εκκινεί
    το analytics-consumer container. Το CREATE TABLE IF NOT EXISTS εδώ είναι
    ιδεμπότητο (defense-in-depth) — ο πίνακας κανονικά δημιουργείται ήδη από
    το init_timescale.sql κατά την αρχικοποίηση της βάσης."""
    if not dsn:
        print("[analytics_consumer] TIMESCALE_DSN δεν έχει οριστεί — τα alerts δεν θα γραφτούν στην TimescaleDB.")
        return None
    last_error = None
    for attempt in range(1, retries + 1):
        try:
            conn = psycopg2.connect(dsn)
            conn.autocommit = True
            with conn.cursor() as cur:
                cur.execute("""
                    CREATE TABLE IF NOT EXISTS digital_twin_alerts (
                        "timestamp" TIMESTAMPTZ NOT NULL,
                        node_id TEXT NOT NULL,
                        anomaly_type TEXT,
                        severity TEXT,
                        severity_level TEXT,
                        function_name TEXT,
                        control_action TEXT,
                        action_value DOUBLE PRECISION
                    )
                """)
                cur.execute("""
                    SELECT create_hypertable('digital_twin_alerts', 'timestamp', if_not_exists => TRUE)
                """)
                cur.execute("""
                    CREATE TABLE IF NOT EXISTS voltage_zscore_eval (
                        "timestamp" TIMESTAMPTZ NOT NULL,
                        node_id TEXT NOT NULL,
                        voltage DOUBLE PRECISION,
                        median_v DOUBLE PRECISION,
                        mad_v DOUBLE PRECISION,
                        z_score DOUBLE PRECISION,
                        predicted_p2 BOOLEAN,
                        predicted_p1 BOOLEAN
                    )
                """)
                cur.execute("""
                    SELECT create_hypertable('voltage_zscore_eval', 'timestamp', if_not_exists => TRUE)
                """)
            print("[analytics_consumer] TimescaleDB alerts + voltage_zscore_eval hypertables έτοιμα.")
            return conn
        except Exception as exc:
            last_error = exc
            print(f"[analytics_consumer] αναμονή TimescaleDB για alerts ({attempt}/{retries}): {exc}")
            time_module.sleep(delay_s)
    print(f"[analytics_consumer] ΑΠΟΤΥΧΙΑ σύνδεσης στην TimescaleDB για alerts μετά από {retries} προσπάθειες: {last_error}")
    return None


class AnalyticsEngine:
    def __init__(self, sqlite_conn, kafka_producer, timescale_conn=None):
        self.conn = sqlite_conn
        self.producer = kafka_producer
        self.timescale_conn = timescale_conn
        self._last_alert_at = {}  # (anomaly_type, node_id) -> monotonic timestamp, για cooldown
        self._voltage_window = defaultdict(lambda: deque(maxlen=VOLTAGE_ZSCORE_WINDOW))  # node_id -> τελευταίες τιμές τάσης
        self._voltage_warning_streak = defaultdict(int)   # node_id -> συνεχόμενα δείγματα πάνω από WARNING
        self._voltage_critical_streak = defaultdict(int)  # node_id -> συνεχόμενα δείγματα πάνω από CRITICAL

    def _should_alert(self, anomaly_type, node_id):
        """Αποτρέπει το ίδιο anomaly_type στον ίδιο κόμβο να καταγράφεται
        κάθε δευτερόλεπτο όσο επιμένει η συνθήκη· επιτρέπει νέο alert μόνο
        μετά το cooldown. Το κλειδί περιλαμβάνει node_id ώστε ταυτόχρονες
        ανωμαλίες σε διαφορετικούς κόμβους να μην κρύβει η μία την άλλη.

        ΣΗΜΑΝΤΙΚΟ: το time.monotonic() ΔΕΝ ξεκινάει από το 0 — μετράει από
        ένα αυθαίρετο σημείο αναφοράς (συχνά την εκκίνηση του συστήματος/
        container). Αν χρησιμοποιούσαμε default τιμή 0.0 για το 'last' σε
        μη-υπαρκτό key, τότε στα πρώτα ALERT_COOLDOWN_S δευτερόλεπτα μετά
        την εκκίνηση του container, ΚΑΘΕ πρώτο alert κάθε τύπου θα
        θεωρούνταν λανθασμένα ότι βρίσκεται ήδη σε cooldown και θα
        αγνοούνταν σιωπηλά. Γι' αυτό ελέγχουμε ρητά αν το key υπάρχει ήδη."""
        import time as _time
        now = _time.monotonic()
        key = (anomaly_type, node_id)
        last = self._last_alert_at.get(key)
        if last is not None and now - last < ALERT_COOLDOWN_S:
            return False
        self._last_alert_at[key] = now
        return True

    def log_alert(self, timestamp, node_id, anomaly_type, severity, control_action, action_value):
        severity_level, function_name = classify_anomaly(anomaly_type)
        self.conn.execute(
            """INSERT INTO digital_twin_alerts
               (timestamp, node_id, anomaly_type, severity, severity_level, function_name, control_action, action_value)
               VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
            (timestamp, node_id, anomaly_type, severity, severity_level, function_name, control_action, action_value),
        )
        self.conn.commit()
        self._log_alert_to_timescale(timestamp, node_id, anomaly_type, severity, severity_level, function_name, control_action, action_value)
        self.producer.send(KAFKA_TOPIC_ALERTS, {
            'timestamp': timestamp,
            'node_id': node_id,
            'anomaly_type': anomaly_type,
            'severity': severity,
            'severity_level': severity_level,
            'function_name': function_name,
            'control_action': control_action,
            'action_value': action_value,
        })
        self._print_alert_row(timestamp, node_id, severity_level, function_name, control_action, action_value)

    def _log_alert_to_timescale(self, timestamp, node_id, anomaly_type, severity, severity_level, function_name, control_action, action_value):
        """Dual-write του alert στην TimescaleDB, ώστε το Grafana να έχει
        απευθείας πρόσβαση μέσω του υπάρχοντος PostgreSQL data source. Τυχόν
        σφάλμα εδώ απομονώνεται (δεν διακόπτει την ανίχνευση ανωμαλιών ή
        την εγγραφή στο SQLite, που παραμένει η κύρια πηγή αλήθειας)."""
        if self.timescale_conn is None:
            return
        try:
            with self.timescale_conn.cursor() as cur:
                cur.execute(
                    """INSERT INTO digital_twin_alerts
                       ("timestamp", node_id, anomaly_type, severity, severity_level, function_name, control_action, action_value)
                       VALUES (%s, %s, %s, %s, %s, %s, %s, %s)""",
                    (timestamp, node_id, anomaly_type, severity, severity_level, function_name, control_action, action_value),
                )
        except Exception as exc:
            print(f"[analytics_consumer] αποτυχία εγγραφής alert στην TimescaleDB (αγνοείται): {exc}")

    def log_zscore_eval(self, timestamp, node_id, voltage, median_v, mad_v, z_score, predicted_p2, predicted_p1):
        """Καταγράφει το Modified Z-score σε ΚΑΘΕ αξιολόγηση τάσης (όχι μόνο
        όταν ξεπερνά κάποιο threshold/σκάει alert), στο hypertable
        voltage_zscore_eval. Στόχος: μια συνεχής, ζωντανή χρονοσειρά
        z-score στο Grafana — ίδιας μορφής με το ανεξάρτητο OSBAD validation
        experiment (ίδιος αλγόριθμος, ίδιο MAD factor, ίδια thresholds),
        ώστε τα δύο να είναι άμεσα συγκρίσιμα πάνω σε κοινό y-άξονα (z-score).
        Τα predicted_p2/predicted_p1 έχουν ΙΔΙΑ σημασιολογία με τις στήλες
        "Predicted (p=2)"/"Predicted (p=1)" του OSBAD validation πίνακα —
        θα σήκωνε alert ο ανιχνευτής σε αυτό το δείγμα, με persistence=2
        (η προεπιλογή) ή persistence=1 (χωρίς απαίτηση συνέχειας) αντίστοιχα.
        Aν δεν υπάρχει σύνδεση στην TimescaleDB, αποτυγχάνει σιωπηλά — δεν
        διακόπτει ποτέ την ίδια την ανίχνευση ανωμαλιών."""
        if self.timescale_conn is None:
            return
        try:
            with self.timescale_conn.cursor() as cur:
                cur.execute(
                    """INSERT INTO voltage_zscore_eval
                       ("timestamp", node_id, voltage, median_v, mad_v, z_score, predicted_p2, predicted_p1)
                       VALUES (%s, %s, %s, %s, %s, %s, %s, %s)""",
                    (timestamp, node_id, voltage, median_v, mad_v, z_score, predicted_p2, predicted_p1),
                )
        except Exception as exc:
            print(f"[analytics_consumer] αποτυχία εγγραφής z-score στην TimescaleDB (αγνοείται): {exc}")

    # Πλάτη στηλών για το tabular console output (Function/Result table).
    _TABLE_COL_WIDTHS = {"severity": 8, "node": 16, "function": 18, "result": 24}

    def _print_alert_row(self, timestamp, node_id, severity_level, function_name, control_action, action_value):
        """Τυπώνει κάθε alert ως γραμμή πίνακα (Severity | Node | Function | Result),
        με οπτικό δείκτη σοβαρότητας (●/▲/■) αντί για απλό θαυμαστικό, ώστε η
        τριβάθμια κλίμακα LOW/MEDIUM/HIGH να ξεχωρίζει άμεσα στο μάτι μέσα στο log."""
        marker = {"LOW": " ●", "MEDIUM": " ▲", "HIGH": " ■"}.get(severity_level, " ?")
        result = f"{control_action} ({action_value})"
        w = self._TABLE_COL_WIDTHS
        print(
            f"{marker} [{severity_level:<{w['severity']}}] {timestamp}  "
            f"{node_id:<{w['node']}} {function_name:<{w['function']}} | {result}"
        )

    def print_alert_table_header(self):
        """Τυπώνει την κεφαλίδα του πίνακα alerts μία φορά κατά την εκκίνηση,
        ώστε οι επόμενες γραμμές (_print_alert_row) να διαβάζονται ως στήλες."""
        w = self._TABLE_COL_WIDTHS
        header = (
            f"   [{'SEVERITY':<{w['severity']}}] {'TIMESTAMP':<32}  "
            f"{'NODE':<{w['node']}} {'FUNCTION':<{w['function']}} | RESULT"
        )
        print(header)
        print("-" * len(header))

    def send_command(self, node_id, command, factor, reason):
        self.producer.send(KAFKA_TOPIC_COMMANDS, {
            'timestamp': datetime.now(timezone.utc).isoformat(),
            'grid_name': "{{ grid_name }}",
            'node_id': node_id,
            'command': command,
            'factor': factor,
            'reason': reason,
        })

    def evaluate(self, payload):
        timestamp = payload.get('timestamp') or datetime.now(timezone.utc).isoformat()
        node_id = payload['node_id']
        frequency = payload.get('frequency')
        congestion_level = payload.get('congestion_level')

        # Η συχνότητα είναι ιδιότητα ΟΛΟΥ του δικτύου, όχι ανά κόμβο — κάθε
        # μήνυμα τηλεμετρίας κουβαλάει την ίδια τιμή. Την αξιολογούμε μία
        # φορά ανά βήμα, πάνω σε έναν representative κόμβο (SubStation),
        # αλλιώς θα καταγράφαμε N πανομοιότυπα alerts (ένα ανά κόμβο) για
        # το ίδιο ακριβώς γεγονός.
        #
        # Σταδιακή (3-tier) αποκοπή φορτίου, κατ' αναλογία πραγματικών
        # σχημάτων UFLS (Lakshminarayana et al. 2022): κάθε στάδιο πιο
        # σοβαρής πτώσης συχνότητας αυξάνει σωρευτικά το ποσοστό αποκοπής,
        # αντί για ένα μοναδικό CRITICAL κατώφλι.
        if frequency is not None and payload.get('node_type') == 'SubStation':
            if frequency < FREQ_STAGE_3_HZ and self._should_alert("CRITICAL_LOW_FREQUENCY_STAGE3", node_id):
                self.log_alert(timestamp, node_id, "CRITICAL_LOW_FREQUENCY_STAGE3", "CRITICAL",
                                "Emergency Load Shedding Stage 3", 0.25)
                self.send_command(node_id, "force_load_shedding", 0.25, "CRITICAL_LOW_FREQUENCY_STAGE3")
            elif frequency < FREQ_STAGE_2_HZ and self._should_alert("CRITICAL_LOW_FREQUENCY_STAGE2", node_id):
                self.log_alert(timestamp, node_id, "CRITICAL_LOW_FREQUENCY_STAGE2", "CRITICAL",
                                "Emergency Load Shedding Stage 2", 0.15)
                self.send_command(node_id, "force_load_shedding", 0.15, "CRITICAL_LOW_FREQUENCY_STAGE2")
            elif frequency < FREQ_STAGE_1_HZ and self._should_alert("CRITICAL_LOW_FREQUENCY_STAGE1", node_id):
                self.log_alert(timestamp, node_id, "CRITICAL_LOW_FREQUENCY_STAGE1", "CRITICAL",
                                "Emergency Load Shedding Stage 1", 0.05)
                self.send_command(node_id, "force_load_shedding", 0.05, "CRITICAL_LOW_FREQUENCY_STAGE1")
            elif frequency < QUALITY_THRESHOLD_LOW_F and self._should_alert("WARNING_LOW_FREQUENCY", node_id):
                self.log_alert(timestamp, node_id, "WARNING_LOW_FREQUENCY", "WARNING",
                                "Battery Injection", 0.25)
            elif frequency > 50.05 and self._should_alert("WARNING_HIGH_FREQUENCY", node_id):
                self.log_alert(timestamp, node_id, "WARNING_HIGH_FREQUENCY", "WARNING",
                                "Battery Absorption", 0.15)

        if payload.get('node_type') == 'SubStation' and congestion_level is not None:
            if congestion_level > CONGESTION_CRITICAL_THRESHOLD and self._should_alert("CRITICAL_CONGESTION", node_id):
                self.log_alert(timestamp, node_id, "CRITICAL_CONGESTION", "CRITICAL",
                                "Congestion Handling", congestion_level)
                self.send_command(node_id, "force_curtail_thermal", 1.0, "CRITICAL_CONGESTION")

        # --- Ανωμαλίες μπαταρίας: overdischarge / overcharge (SOC) ---
        state_of_charge = payload.get('state_of_charge')
        if payload.get('node_type') == 'BatteryStorage' and state_of_charge is not None:
            if state_of_charge < SOC_CRITICAL_LOW and self._should_alert("CRITICAL_LOW_SOC", node_id):
                self.log_alert(timestamp, node_id, "CRITICAL_LOW_SOC", "CRITICAL",
                                "Stop Discharge", state_of_charge)
                self.send_command(node_id, "stop_discharge", 0.0, "CRITICAL_LOW_SOC")
            elif state_of_charge < SOC_WARNING_LOW and self._should_alert("WARNING_LOW_SOC", node_id):
                self.log_alert(timestamp, node_id, "WARNING_LOW_SOC", "WARNING",
                                "Reduce Discharge Rate", state_of_charge)
            elif state_of_charge > SOC_CRITICAL_HIGH and self._should_alert("CRITICAL_HIGH_SOC", node_id):
                self.log_alert(timestamp, node_id, "CRITICAL_HIGH_SOC", "CRITICAL",
                                "Stop Charge", state_of_charge)
                self.send_command(node_id, "stop_charge", 0.0, "CRITICAL_HIGH_SOC")
            elif state_of_charge > SOC_WARNING_HIGH and self._should_alert("WARNING_HIGH_SOC", node_id):
                self.log_alert(timestamp, node_id, "WARNING_HIGH_SOC", "WARNING",
                                "Reduce Charge Rate", state_of_charge)

        # --- Απόκλιση τάσης: rolling Modified Z-score (διάμεσος/MAD) ανά
        # κόμβο (|Z_mod|>3.5, βλ. σχόλιο στα constants). Χρησιμοποιούμε τη
        # διάμεσο/MAD αντί για μέση τιμή/SD ώστε η ανίχνευση να παραμένει
        # αξιόπιστη ανεξαρτήτως του σχήματος της υποκείμενης κατανομής
        # θορύβου (η οποία καθορίζεται δυναμικά ανά .seg μοντέλο, όχι στον
        # κώδικα) — π.χ. δεν προϋποθέτει κανονική κατανομή, σε αντίθεση με
        # το κλασικό Z-score. Χρειάζονται τουλάχιστον VOLTAGE_ZSCORE_MIN_SAMPLES
        # δείγματα στο window πριν αξιολογηθεί, αλλιώς το MAD υπολογίζεται
        # από πολύ λίγα σημεία και γίνεται τεχνητά μικρό, παράγοντας ψευδώς
        # θετικά. Επιπλέον, απαιτούμε η απόκλιση να επιμείνει για
        # VOLTAGE_PERSISTENCE_SAMPLES συνεχόμενα δείγματα πριν καταγραφεί
        # alert, ώστε μεμονωμένες τυχαίες υπερβάσεις να μην πλημμυρίζουν το log.
        #
        # ΣΗΜΕΙΩΣΗ (log_zscore_eval): σε αντίθεση με το log_alert (που γράφεται
        # ΜΟΝΟ όταν ξεπεραστεί threshold ΚΑΙ επιμείνει για PERSISTENCE_SAMPLES
        # δείγματα), το log_zscore_eval γράφεται σε ΚΑΘΕ αξιολόγηση όπου
        # υπολογίζεται πραγματικό z (δηλ. μόλις γεμίσει το ελάχιστο παράθυρο),
        # ανεξαρτήτως αν τελικά σκάσει alert — ώστε η χρονοσειρά z-score στο
        # Grafana να είναι συνεχής, όχι μόνο τα σποραδικά σημεία των alerts.
        voltage = payload.get('voltage')
        if voltage is not None and voltage > 0:
            window = self._voltage_window[node_id]
            if len(window) >= VOLTAGE_ZSCORE_MIN_SAMPLES:
                median_v = statistics.median(window)
                mad_v = statistics.median([abs(x - median_v) for x in window]) * VOLTAGE_MAD_FACTOR
                # Κατώτατο όριο στο MAD ώστε ένα φυσιολογικά "ήσυχο" διάστημα
                # (πολύ μικρό πραγματικό MAD) να μην κάνει το σκορ απόκλισης
                # υπερευαίσθητο σε μικρές, φυσιολογικές διακυμάνσεις.
                mad_floor = abs(median_v) * VOLTAGE_ZSCORE_MIN_STD_FRACTION
                mad_v = max(mad_v, mad_floor)
                if mad_v > 0:
                    z = abs(voltage - median_v) / mad_v

                    if z > VOLTAGE_ZSCORE_CRITICAL:
                        self._voltage_critical_streak[node_id] += 1
                        self._voltage_warning_streak[node_id] += 1
                    elif z > VOLTAGE_ZSCORE_WARNING:
                        self._voltage_critical_streak[node_id] = 0
                        self._voltage_warning_streak[node_id] += 1
                    else:
                        self._voltage_critical_streak[node_id] = 0
                        self._voltage_warning_streak[node_id] = 0

                    # predicted_p2/predicted_p1: ΙΔΙΑ λογική με το OSBAD
                    # validation experiment — p2 = θα σήκωνε alert με το
                    # τρέχον persistence=2 (VOLTAGE_PERSISTENCE_SAMPLES),
                    # p1 = θα σήκωνε alert χωρίς απαίτηση συνέχειας (μόνο
                    # z > CRITICAL σε αυτό ακριβώς το δείγμα). Υπολογίζεται
                    # ΠΡΙΝ το _should_alert (cooldown), αφού το predicted flag
                    # πρέπει να αντανακλά την κατάσταση του ανιχνευτή, όχι αν
                    # καταγράφηκε ήδη πρόσφατο alert του ίδιου τύπου.
                    predicted_p2 = self._voltage_critical_streak[node_id] >= VOLTAGE_PERSISTENCE_SAMPLES
                    predicted_p1 = z > VOLTAGE_ZSCORE_CRITICAL
                    self.log_zscore_eval(timestamp, node_id, voltage, median_v, mad_v, z, predicted_p2, predicted_p1)

                    if (self._voltage_critical_streak[node_id] >= VOLTAGE_PERSISTENCE_SAMPLES
                            and self._should_alert("CRITICAL_VOLTAGE_DEVIATION", node_id)):
                        self.log_alert(timestamp, node_id, "CRITICAL_VOLTAGE_DEVIATION", "CRITICAL",
                                        "Voltage Regulation", voltage)
                    elif (self._voltage_warning_streak[node_id] >= VOLTAGE_PERSISTENCE_SAMPLES
                            and self._should_alert("WARNING_VOLTAGE_DEVIATION", node_id)):
                        self.log_alert(timestamp, node_id, "WARNING_VOLTAGE_DEVIATION", "WARNING",
                                        "Monitor Voltage", voltage)
            window.append(voltage)


def safe_json_deserialize(raw_bytes):
    """Ο value_deserializer τρέχει ΜΕΣΑ στο kafka-python fetch loop· αν
    σκάσει εκεί, η εξαίρεση προπαγάρεται πάνω από το for-loop του καλούντος
    και τερματίζει ολόκληρο τον consumer (ό,τι είδαμε: crash-loop σε παλιά,
    ήδη-χαλασμένα μηνύματα του topic). Γι' αυτό η αποκωδικοποίηση γίνεται
    εδώ, με ασφαλές fallback σε None αντί να σκάει προς τα έξω."""
    try:
        return json.loads(raw_bytes.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError, AttributeError) as exc:
        print(f"[analytics_consumer] skipping malformed message ({exc})")
        return None


def consume_raw_telemetry(engine):
    consumer = KafkaConsumer(
        KAFKA_TOPIC_RAW,
        bootstrap_servers=KAFKA_BOOTSTRAP_SERVERS,
        group_id=KAFKA_GROUP_ID,
        value_deserializer=safe_json_deserialize,
        auto_offset_reset="latest",
        enable_auto_commit=True,
    )
    print(f"[analytics_consumer] listening on '{KAFKA_TOPIC_RAW}' for anomaly detection ...")
    engine.print_alert_table_header()
    for message in consumer:
        if message.value is None:
            continue
        engine.evaluate(message.value)


def consume_grid_events():
    """Stub listener για γεγονότα τοπολογίας (LINE_FAILED, NODE_ISOLATED, ...).
    Επέκταση: εδώ μπορεί να συνδεθεί μελλοντικά notification/orchestration
    service — προς το παρόν απλώς καταγράφει τα events στο log."""
    consumer = KafkaConsumer(
        KAFKA_TOPIC_EVENTS,
        bootstrap_servers=KAFKA_BOOTSTRAP_SERVERS,
        group_id=KAFKA_GROUP_ID,
        value_deserializer=safe_json_deserialize,
        auto_offset_reset="latest",
        enable_auto_commit=True,
    )
    print(f"[analytics_consumer] listening on '{KAFKA_TOPIC_EVENTS}' for topology events ...")
    for message in consumer:
        if message.value is None:
            continue
        print(f"[analytics_consumer] grid event received: {message.value}")


def create_kafka_producer(retries=10, delay_s=3):
    """Δημιουργεί τον KafkaProducer με retry logic, αφού το 'depends_on'
    του Docker Compose εγγυάται μόνο ότι το container του Kafka έχει
    ξεκινήσει — όχι ότι ο broker είναι ήδη έτοιμος να δεχτεί συνδέσεις.
    Χωρίς αυτό, η πρώτη προσπάθεια σύνδεσης μπορεί να αποτύχει με
    KafkaTimeoutError λίγα δευτερόλεπτα μετά την εκκίνηση, αφήνοντας το
    container να κρασάρει και να επανεκκινήσει μέσω του 'restart:
    unless-stopped' — λειτουργικό, αλλά όχι σωστός τρόπος αντιμετώπισης."""
    last_error = None
    for attempt in range(1, retries + 1):
        try:
            producer = KafkaProducer(
                bootstrap_servers=KAFKA_BOOTSTRAP_SERVERS,
                value_serializer=lambda v: json.dumps(v).encode("utf-8"),
            )
            print("[analytics_consumer] σύνδεση με Kafka producer επιτυχής.")
            return producer
        except Exception as exc:
            last_error = exc
            print(f"[analytics_consumer] αναμονή Kafka producer ({attempt}/{retries}): {exc}")
            time_module.sleep(delay_s)
    raise RuntimeError(f"Αποτυχία σύνδεσης στο Kafka μετά από {retries} προσπάθειες: {last_error}")


def main():
    sqlite_conn = init_db(SQLITE_PATH)
    timescale_conn = init_timescale_alerts(TIMESCALE_DSN)
    producer = create_kafka_producer()
    engine = AnalyticsEngine(sqlite_conn, producer, timescale_conn)

    events_thread = threading.Thread(target=consume_grid_events, daemon=True)
    events_thread.start()

    try:
        consume_raw_telemetry(engine)
    except KeyboardInterrupt:
        pass
    finally:
        producer.flush()
        sqlite_conn.close()
        if timescale_conn is not None:
            timescale_conn.close()


if __name__ == "__main__":
    main()
